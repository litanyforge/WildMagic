{
  "meta": {
    "name": "Whatever Generator",
    "version": "0.1",
    "date": "2026-11-02",
    "status": "DRAFT for Keith to shape — every list is editable, nothing here is canon until he keeps it",
    "idea": "No predefined recipes. A row of slots (3-4 by default, add or remove as needed). Each slot picks a category and rolls a word from it. The output is the bare pile of words with NO connecting words whatsoever — interpretation happens at the table.",
    "slot_rules": {
      "category": "slot rolls a random entry from the named category",
      "word": "a slot can instead be PINNED to a fixed word (written as word:Desert) — this is how targets, biomes, and other context enter; the pinned slot stays fixed while the rest reroll",
      "reroll": "any single slot can be rerolled without touching the others",
      "arrangements": "a slot setup that works can be saved below under a name — recipes that condense out of play, never predefined"
    },
    "content_rules": [
      "Fantasy-first: in-world, almost nobody encounters anything non-fantasy, and anything modern reads as ancient.",
      "Words should be loaded — every entry ideally does double duty when it collides with another slot.",
      "Lists can be any length; they grow by accretion as good words are found."
    ],
    "structure_stolen_from": "Mythic Meaning Tables (action/description split), Ironsworn oracles (action + theme pairing), Maze Rats (multi-column collision generation)"
  },
